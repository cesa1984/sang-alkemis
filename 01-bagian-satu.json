        "\u201C", ["Aku", "I"], ["menangisi", "weep-for"], ["Narcissus", "Narcissus"], ",",
        ["tapi", "but"], ["tak", "not"], ["pernah", "ever"],
        ["kuperhatikan", "did-I-notice"], ["bahwa", "that"], ["Narcissus", "Narcissus"],
        ["itu", "he"], ["indah", "beautiful"], "."
      ]
    },
    {
      "dialog": true,
      "en": "I weep because, each time he knelt beside my shore, I could see, in the depths of his eyes, the reflection of my own beauty.\"",
      "t": [
