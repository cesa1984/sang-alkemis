        "\u201C", ["Oh", "oh"], ",", ["tak", "not"], ["heranlah", "surprising"],
        ["jika", "if/that"], ["kau", "you"], ["menangisi", "weep-for"],
        ["Narcissus", "Narcissus"], ",", "\u201D"
