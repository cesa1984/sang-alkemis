        ["dia", "he"], ["menemukan", "found"], ["sebuah", "a"], ["kisah", "story"],
        ["tentang", "about"], ["Narcissus", "Narcissus"], "."
      ]
    },
    {
      "en": "The alchemist already knew the legend of Narcissus, a young man who every day knelt beside a lake to admire his own beauty.",
      "t": [
        ["Alkemis", "alchemist"], ["itu", "the/that"], ["sudah", "already"],
