    },
    "PARA",
    {
      "dialog": true,
      "en": "\"I weep for Narcissus,\" answered the lake.",
      "t": [
        "\u201C", ["Aku", "I"], ["menangisi", "weep-for"], ["Narcissus", "Narcissus"], ",", "\u201D"
