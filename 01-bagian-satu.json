        ["yang", "which"], ["semula", "originally"], ["berupa", "was"],
        ["air", "water"], ["segar", "fresh"], ",",
        ["telah", "had"], ["berubah", "changed"], ["menjadi", "into"],
        ["danau", "a-lake"], ["airmata", "of-tears"], ["yang", "that-is"],
        ["asin", "salty"], "."
      ]
    },
    "PARA",
    {
      "dialog": true,
      "en": "\"Why do you weep?\" asked the goddesses.",
      "t": [
        "\u201C", ["Mengapa", "why"], ["engkau", "you"], ["menangis", "weep"], "?", "\u201D"
