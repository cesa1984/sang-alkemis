    {
      "en": "they said,",
      "t": [["kata", "said"], ["mereka", "they"], ","]
    },
    {
      "dialog": true,
      "en": "\"because although we always sought him in the forest, only you could admire his beauty from up close.\"",
      "t": [
        "\u201C", ["sebab", "because"], ["walau", "although"], ["kami", "we"],
        ["selalu", "always"], ["mencari", "sought"], ["dia", "him"],
        ["di", "in"], ["hutan", "the-forest"], ",",
        ["hanya", "only"], ["kau", "you"], ["saja", "alone"], ["yang", "who"],
        ["dapat", "could"], ["mengagumi", "admire"], ["keindahannya", "his-beauty"],
        ["dari", "from"], ["dekat", "close-by"], ".", "\u201D"
      ]
    },
    "PARA",
    {
      "dialog": true,
      "en": "\"But... was Narcissus beautiful?\" asked the lake.",
      "t": [
        "\u201C", ["Tapi", "but"], "...", ["indahkah", "was-he-beautiful"],
        ["Narcissus", "Narcissus"], "?", "\u201D"
