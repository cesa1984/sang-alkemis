    {
      "en": "asked the lake.",
      "t": [["tanya", "asked"], ["danau", "the-lake"], "."]
    },
    "PARA",
    {
      "dialog": true,
      "en": "\"Who would know better than you?\" the goddesses asked in wonder.",
      "t": [
        "\u201C", ["Siapa", "who"], ["yang", "that"], ["lebih", "more"],
        ["mengetahuinya", "knows-it"], ["daripada", "than"], ["engkau", "you"], "?", "\u201D"
      ]
    },
    {
      "en": "the goddesses asked in wonder.",
      "t": [["dewi-dewi", "the-goddesses"], ["bertanya", "asked"], ["heran", "in-wonder"], "."]
    },
    {
      "dialog": true,
      "en": "\"It was right beside you that he knelt every day, admiring himself!\"",
      "t": [
        "\u201C", ["Di", "at"], ["dekatmulah", "right-beside-you"], ["ia", "he"],
        ["tiap", "every"], ["hari", "day"], ["berlutut", "knelt"],
